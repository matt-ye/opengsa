{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "source_id",
          "action",
          "reviewer",
          "reason",
          "reviewed_on"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "enum": [
              "applied",
              "noted",
              "dismissed"
            ]
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "applied"
                }
              }
            },
            "then": {
              "required": [
                "candidate_id",
                "candidate_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}
