{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenGSA evidence-linked temporal projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "submission_mode", "review_mode", "rules", "gaps"],
  "properties": {
    "version": {"const": "time-policy-1"},
    "submission_mode": {"enum": ["fixed_window", "deadline_only", "start_only", "event_relative", "recurring", "rule_text", "mixed", "procedure_only", "conditional_deadline", "automatic", "reference", "undetermined"]},
    "review_mode": {"enum": ["not_stated", "rolling", "batch", "case_by_case"]},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "gaps": {"type": "array", "uniqueItems": true, "items": {"enum": ["source_checks_failed", "time_not_projected", "student_window_not_recorded", "needs_event_date", "calendar_unverified", "personal_conditions_required"]}}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "revision_id", "locator", "evidence_path"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "evidence_path": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "kind", "stage", "actor", "summary", "value", "precision", "anchor_event", "source_refs"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["absolute", "event_relative", "recurring", "text_rule"]},
        "stage": {"enum": ["application_start", "submission", "supplement", "result"]},
        "actor": {"enum": ["student", "department", "unit", "college", "university", "institution", "supplement", "other"]},
        "summary": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "null"]},
        "precision": {"enum": ["date", "datetime", "rule"]},
        "anchor_event": {"enum": [null, "conference_start"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "absolute"}}}, "then": {"properties": {"value": {"type": "string"}, "precision": {"enum": ["date", "datetime"]}}}, "else": {"properties": {"value": {"type": "null"}, "precision": {"const": "rule"}}}},
        {"if": {"properties": {"precision": {"const": "date"}}}, "then": {"properties": {"value": {"type": "string", "format": "date"}}}},
        {"if": {"properties": {"precision": {"const": "datetime"}}}, "then": {"properties": {"value": {"type": "string", "format": "date-time", "pattern": "\\+08:00$"}}}}
      ]
    }
  }
}
